{
  "name": "lkrag-lite",
  "version": "0.1.0",
  "description": "Lightweight, easy-to-deploy RAG system for local files",
  "license": "MIT",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('node_modules/marked/lib/marked.umd.js','public/marked.min.js')\"",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fast-glob": "^3.3.3",
    "mammoth": "^1.12.0",
    "marked": "^18.0.5",
    "pdf-parse": "^1.1.1",
    "sqlite-vec": "^0.1.9",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
