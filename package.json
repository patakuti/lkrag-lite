{
  "name": "lkrag-lite",
  "version": "0.1.0",
  "description": "Lightweight, easy-to-deploy RAG system for local files",
  "license": "MIT",
  "main": "dist/server.js",
  "bin": {
    "lkragl": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');for(const dir of ['public','public-chat']){fs.copyFileSync('node_modules/marked/lib/marked.umd.js',dir+'/marked.min.js')}\"",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "pkg:build": "pkg dist/cli.js --config package.json --out-path pkg-dist",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "commander": "^12.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fast-glob": "^3.3.3",
    "mammoth": "^1.12.0",
    "marked": "^18.0.5",
    "officeparser": "^7.2.1",
    "pdf-parse": "^1.1.1",
    "sqlite-vec": "^0.1.9",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.1"
  },
  "pkg": {
    "scripts": [
      "node_modules/fflate/lib/*.cjs"
    ],
    "assets": [
      "node_modules/better-sqlite3/build/Release/better_sqlite3.node",
      "node_modules/sqlite-vec-linux-x64/vec0.so",
      "node_modules/sqlite-vec-windows-x64/vec0.dll",
      "node_modules/sqlite-vec-darwin-arm64/vec0.dylib",
      "node_modules/sqlite-vec-darwin-x64/vec0.dylib",
      "node_modules/pdf-parse/lib/pdf.js/**"
    ],
    "fallbackToSource": true,
    "outputPath": "pkg-dist"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@yao-pkg/pkg": "^6.20.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
