# ===== Database =====
DATABASE_PATH=./data/lkrag.db

# ===== Index targets (shared across workspaces) =====
RAG_INCLUDE_PATTERNS=**/*.md,**/*.txt,**/*.pdf,**/*.docx,**/*.xlsx,**/*.pptx,**/*.html
RAG_EXCLUDE_PATTERNS=node_modules/**,.git/**

# ===== Embedding =====
EMBEDDING_PROVIDER=openai              # openai / openai-compatible (use openai-compatible for LiteLLM, Ollama, llama.cpp's llama-server, etc.)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=sk-...
# EMBEDDING_BASE_URL=http://localhost:11434/v1  # only used when EMBEDDING_PROVIDER=openai-compatible
#   This app always POSTs to {EMBEDDING_BASE_URL}/embeddings (OpenAI-compatible route).
#   Point this at the API root ending in /v1, NOT a vendor-native path (e.g. llama.cpp's own /embedding).
#   e.g. http://localhost:11434/v1 for Ollama, http://localhost:8080/v1 for llama.cpp's llama-server
# EMBEDDING_QUERY_PREFIX=                              # prefix added to query text before embedding
# EMBEDDING_DOCUMENT_PREFIX=                           # prefix added to document text before embedding
# EMBEDDING_BATCH_SIZE=500                             # number of texts embedded per API call

# ===== LLM =====
LLM_PROVIDER=openai                    # openai / anthropic / openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-...
# LLM_BASE_URL=http://localhost:11434/v1  # only used when LLM_PROVIDER=openai-compatible
# ANTHROPIC_API_KEY=sk-ant-...          # for LLM_PROVIDER=anthropic (shared with QUERY_REWRITER_PROVIDER=anthropic)

# ===== RAG parameters =====
RAG_MAX_FILE_SIZE=10485760          # max file size to index in bytes (default: 10MB)
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.3
# RAG_OUTPUT_INSTRUCTIONS=            # Additional instructions appended to LLM system prompt (e.g. "Answer in Japanese.")

# ===== Query Rewriter =====
QUERY_REWRITER_PROVIDER=openai         # openai / anthropic / openai-compatible
QUERY_REWRITER_MODEL=gpt-4o-mini       # default: gpt-4o-mini (openai) / claude-haiku-4-5 (anthropic)
QUERY_REWRITER_API_KEY=sk-...          # only used for openai / openai-compatible (anthropic uses ANTHROPIC_API_KEY above)
# QUERY_REWRITER_BASE_URL=http://localhost:4000/v1  # only used when QUERY_REWRITER_PROVIDER=openai-compatible

# ===== Server =====
PORT=4456
# BROWSE_ROOT=C:\Users\user\Documents  # Top directory exposed by the file browser (default: user home directory)

# ===== Public chat (read-only, token-authenticated; disabled unless set) =====
# PUBLIC_PORT=4457    # binds 0.0.0.0 on this port to serve token-authenticated read-only chat
# PUBLIC_CHAT_RATE_LIMIT_PER_MIN=20  # max /chat calls per token per rolling minute (default: 20)
# LLM_PRICE_INPUT_PER_1M=          # USD per 1M input/prompt tokens, for estimated cost in access logs (optional)
# LLM_PRICE_OUTPUT_PER_1M=         # USD per 1M output/completion tokens, for estimated cost in access logs (optional)
