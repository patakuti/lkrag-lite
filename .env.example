# ===== Database =====
DATABASE_PATH=./data/lkrag.db

# ===== Index targets (shared across workspaces) =====
RAG_INCLUDE_PATTERNS=**/*.md,**/*.txt,**/*.pdf,**/*.docx,**/*.xlsx,**/*.pptx,**/*.html
RAG_EXCLUDE_PATTERNS=node_modules/**,.git/**

# ===== Embedding =====
EMBEDDING_PROVIDER=openai              # openai / litellm / ollama
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=sk-...
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:4000/v1  # for LiteLLM
# OLLAMA_BASE_URL=http://localhost:11434/v1             # for Ollama
# EMBEDDING_QUERY_PREFIX=                              # prefix added to query text before embedding
# EMBEDDING_DOCUMENT_PREFIX=                           # prefix added to document text before embedding

# ===== LLM =====
LLM_PROVIDER=openai                    # openai / anthropic / openai-compatible
LLM_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...          # for Anthropic

# ===== RAG parameters =====
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.3
# RAG_OUTPUT_INSTRUCTIONS=            # Additional instructions appended to LLM system prompt (e.g. "Answer in Japanese.")

# ===== Query Rewriter =====
QUERY_REWRITER_PROVIDER=openai         # openai / openai-compatible / anthropic
QUERY_REWRITER_MODEL=gpt-4o-mini       # default: gpt-4o-mini (openai) / claude-haiku-4-5 (anthropic)
# ANTHROPIC_API_KEY is shared with LLM_PROVIDER=anthropic; set it once above.

# ===== Server =====
PORT=3456
